audit_out/
out/
*.tmp
*.bak
# User data should never be committed by accident
*.csv
*.dta
*.log
!tests/data/*.dta
!tests/data/*.log
!benchmark/pyquaidsce vs quaidsce/*.dta
!benchmark/pyquaidsce vs quaidsce/*.log

# Published Iran demand-system benchmark data and results
!benchmark/censored_vs_uncensored_iran/data/*.csv
!benchmark/censored_vs_uncensored_iran/results/*.csv
!benchmark/censored_vs_uncensored_iran/results/raw/*.csv
!benchmark/censored_vs_uncensored_iran/results/logs/*.log
