*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Packaging/build outputs
build/
dist/
*.egg-info/
*.whl

# IDE / OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

